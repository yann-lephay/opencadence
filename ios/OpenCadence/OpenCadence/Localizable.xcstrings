          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo — control en tamaños pequeños"
          }
        }
      }
    },
    "Léger": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leicht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligera"
          }
        }
      }
    },
    "L’abonnement se renouvelle automatiquement jusqu’à sa résiliation depuis votre compte Apple. L’annuel et le mensuel donnent accès aux mêmes fonctions.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abo verlängert sich automatisch, bis du es in deinem Apple Account kündigst. Jahres- und Monatsabo bieten Zugriff auf dieselben Funktionen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription renews automatically until cancelled from your Apple account. Annual and monthly plans provide access to the same features."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción se renueva automáticamente hasta que la canceles desde tu cuenta de Apple. Los planes anual y mensual dan acceso a las mismas funciones."
          }
        }
      }
    },
    "L’achat attend encore la confirmation d’Apple. L’app vérifiera de nouveau ton accès automatiquement.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wartet noch auf die Bestätigung von Apple. Die App prüft deinen Zugriff automatisch erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase is still awaiting confirmation from Apple. The app will check your access again automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra sigue esperando la confirmación de Apple. La app volverá a comprobar tu acceso automáticamente."
          }
        }
      }
    },
    "L’achat n’a pas abouti. Rien n’a été débité par l’app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wurde nicht abgeschlossen. Die App hat keine Abbuchung vorgenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase did not complete. The app has not charged you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra no se ha completado. La app no ha realizado ningún cargo."
          }
        }
      }
    },
    "L’achat à vie n’est pas encore disponible.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf für lebenslangen Zugang ist noch nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lifetime purchase is not available yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra de por vida aún no está disponible."
          }
        }
      }
    },
    "L’enregistrement a échoué. Tes saisies sont conservées pour réessayer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Speichern ist fehlgeschlagen. Deine Eingaben bleiben für einen neuen Versuch erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
