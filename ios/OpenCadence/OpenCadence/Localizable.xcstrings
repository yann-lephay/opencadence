    "Pour chaque poids, indique le nombre total de disques. Un montage utilise la même charge de chaque côté d’une poignée.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib für jedes Gewicht die Gesamtzahl der Scheiben an. An jedem Griff wird auf beiden Seiten dieselbe Last verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For each weight, enter the total number of plates. Each handle uses the same load on both sides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cada peso, indica el número total de discos. Cada mango lleva la misma carga a ambos lados."
          }
        }
      }
    },
