            "value": "Captura no disponible"
          }
        }
      }
    },
    "Ce choix reste actif jusqu’à ce que tu le modifies ici. Il concerne cette configuration précise, pas toutes les variantes du mouvement.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Auswahl bleibt aktiv, bis du sie hier änderst. Sie gilt für diese konkrete Ausführung, nicht für alle Varianten der Übung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This choice remains active until you change it here. It applies to this specific setup, not every variation of the movement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta opción seguirá activa hasta que la cambies aquí. Se aplica a esta configuración concreta, no a todas las variantes del movimiento."
          }
        }
      }
    },
    "Ce mouvement est impossible ici": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Übung ist hier nicht möglich"
          }
        },
        "en": {
