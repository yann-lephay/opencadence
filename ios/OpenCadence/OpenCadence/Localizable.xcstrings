        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica al menos un peso que puedas usar con tus mancuernas."
          }
        }
      }
    },
    "Indique au moins une masse réellement disponible pour le gilet.": {
      "localizations": {
