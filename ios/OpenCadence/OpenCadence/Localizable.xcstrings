          }
        }
      }
    },
    "Indique au moins un poids réellement utilisable pour tes haltères.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib mindestens ein tatsächlich nutzbares Gewicht für deine Hanteln an."
          }
        },
        "en": {
