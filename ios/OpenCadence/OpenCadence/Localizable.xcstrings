    "La Bonne Séance": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "La Bonne Séance"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "La Bonne Séance"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Bonne Séance"
          }
        }
      }
    },
    "La Bonne Séance ne peut pas ouvrir ses données locales. Ferme puis relance l’app. Tes données ne seront pas remplacées automatiquement.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "La Bonne Séance kann seine lokalen Daten nicht öffnen. Schließe die App und starte sie erneut. Deine Daten werden nicht automatisch ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "La Bonne Séance cannot open its local data. Close and reopen the app. Your data will not be replaced automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Bonne Séance no puede abrir sus datos locales. Cierra la app y vuelve a abrirla. Tus datos no se sustituirán automáticamente."
          }
        }
      }
    },
    "La Bonne Séance ne possède pas encore le mode dédié nécessaire. Cela ne signifie pas que l’activité physique est interdite.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "La Bonne Séance verfügt noch nicht über den erforderlichen speziellen Modus. Das bedeutet nicht, dass körperliche Aktivität verboten ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "La Bonne Séance does not yet have the required dedicated mode. This does not mean that physical activity is prohibited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Bonne Séance aún no dispone del modo específico necesario. Esto no significa que la actividad física esté prohibida."
          }
        }
      }
    },
    "La Bonne Séance ne proposera que des mouvements faisables avec ce matériel. Tu pourras le modifier à tout moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "La Bonne Séance schlägt nur Übungen vor, die mit dieser Ausrüstung möglich sind. Du kannst sie jederzeit ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "La Bonne Séance will only suggest movements you can perform with this equipment. You can change it at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Bonne Séance solo propondrá movimientos que puedas hacer con este material. Podrás modificarlo en cualquier momento."
          }
        }
      }
    },
    "La Bonne Séance n’en déduit aucun niveau sportif global. Le moteur utilise ces repères seulement pour choisir une variante compatible lors des prochaines séances.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "La Bonne Séance leitet daraus kein allgemeines Fitnessniveau ab. Die Logik nutzt diese Ausgangswerte nur, um in künftigen Trainings eine passende Variante zu wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "La Bonne Séance does not infer an overall fitness level from them. The engine only uses these starting points to choose a suitable variation in future workouts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Bonne Séance no deduce de ellos un nivel deportivo general. El motor solo usa estas referencias para elegir una variante compatible en las próximas sesiones."
          }
        }
      }
    },
    "La V1 ne possède pas encore de mode dédié : le moteur standard restera indisponible, sans présenter l’activité physique comme interdite.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "V1 hat noch keinen speziellen Modus. Die Standardlogik bleibt daher nicht verfügbar, ohne körperliche Aktivität als verboten darzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "V1 does not yet have a dedicated mode: the standard engine will remain unavailable, without presenting physical activity as prohibited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La V1 aún no dispone de un modo específico: el motor estándar seguirá sin estar disponible, sin presentar la actividad física como prohibida."
          }
        }
      }
    },
    "La barre accepte un élastique sans l’abîmer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An der Stange kann ein Band befestigt werden, ohne es zu beschädigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bar can hold a resistance band without damaging it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra admite una banda sin dañarla"
          }
        }
      }
    },
    "La capture de référence n’a pas pu être préparée.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Referenzaufnahme konnte nicht vorbereitet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reference screenshot could not be prepared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido preparar la captura de referencia."
          }
        }
      }
    },
    "La couverture musculaire est partielle avec les mouvements actuellement disponibles.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die verfügbaren Übungen decken nur einen Teil der Muskelgruppen ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The available movements cover only part of the muscle groups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los movimientos disponibles solo cubren parte de los grupos musculares."
          }
        }
      }
    },
    "La date (sans l’heure), les mouvements proposés, les séries, répétitions, charges et repos prévus ou réalisés, ainsi que la version du moteur. Les séances interrompues sont aussi incluses. Aucun historique antérieur à ton accord n’est envoyé.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datum ohne Uhrzeit, vorgeschlagene Übungen, geplante oder absolvierte Sätze, Wiederholungen, Gewichte und Pausen sowie die Version der Trainingslogik. Abgebrochene Trainings sind eingeschlossen. Frühere Trainings vor deiner Einwilligung werden nicht gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The date (without the time), proposed movements, planned or completed sets, reps, weights and rests, and the engine version. Interrupted workouts are included. No history from before your consent is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha (sin la hora), los movimientos propuestos, las series, repeticiones, cargas y descansos previstos o realizados, y la versión del motor. También se incluyen las sesiones interrumpidas. No se envía historial anterior a tu consentimiento."
          }
        }
      }
    },
    "La dernière action reste visible, mais n’est pas encore sauvegardée. Les autres actions sont bloquées pour éviter de compter deux fois.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzte Aktion bleibt sichtbar, wurde aber noch nicht gespeichert. Weitere Aktionen sind gesperrt, damit nichts doppelt gezählt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last action remains visible but has not yet been saved. Other actions are blocked to prevent double counting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última acción sigue visible, pero aún no se ha guardado. Las demás acciones están bloqueadas para evitar que se cuente dos veces."
          }
        }
      }
    },
    "La dernière écriture était incomplète. La sauvegarde valide précédente a été restaurée.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der letzte Speichervorgang war unvollständig. Die vorherige gültige Version wurde wiederhergestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last save was incomplete. The previous valid version has been restored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El último guardado estaba incompleto. Se ha restaurado la copia válida anterior."
          }
        }
      }
    },
    "La durée n’a pas pu être enregistrée. Réessaie avant de démarrer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dauer konnte nicht gespeichert werden. Versuche es vor dem Start erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The duration could not be saved. Try again before starting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar la duración. Inténtalo de nuevo antes de empezar."
          }
        }
      }
    },
    "La prochaine adaptation de %@ repose sur tes résultats enregistrés.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste Anpassung für %@ basiert auf deinen gespeicherten Ergebnissen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next adjustment for %@ is based on your recorded results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La próxima adaptación de %@ se basa en tus resultados registrados."
          }
        }
      }
    },
    "La recherche guide nos principes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Forschung leitet unsere Prinzipien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Research guides our principles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La investigación guía nuestros principios."
          }
        }
      }
    },
    "La recherche.\nDes choix concrets.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Forschung.\nKonkrete Entscheidungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Research.\nConcrete choices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La investigación.\nDecisiones concretas."
          }
        }
      }
    },
    "La restauration n’a pas abouti. Tu peux réessayer sans perdre tes séances.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederherstellung war nicht erfolgreich. Du kannst es erneut versuchen, ohne deine Trainings zu verlieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The restore did not complete. You can try again without losing your workouts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauración no se ha completado. Puedes volver a intentarlo sin perder tus sesiones."
          }
        }
      }
    },
    "La réponse de l’App Store n’est pas reconnue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort des App Store wurde nicht erkannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store response was not recognised."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se reconoce la respuesta del App Store."
          }
        }
      }
    },
    "La résistance décrit cet élastique. Elle n’est pas convertie en kilos et ne classe pas automatiquement tes élastiques.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Widerstand beschreibt dieses Band. Er wird nicht in Kilogramm umgerechnet und legt keine automatische Reihenfolge deiner Bänder fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resistance describes this band. It is not converted to kilograms and does not automatically rank your bands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La resistencia describe esta banda. No se convierte en kilos ni ordena automáticamente tus bandas."
          }
        }
      }
    },
    "La sauvegarde échoue encore. L’action reste visible et ne sera pas recomptée lors du prochain essai.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Speichern ist erneut fehlgeschlagen. Die Aktion bleibt sichtbar und wird beim nächsten Versuch nicht noch einmal gezählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving still failed. The action remains visible and will not be counted again on the next attempt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El guardado sigue fallando. La acción permanece visible y no se volverá a contar en el próximo intento."
          }
        }
      }
    },
    "La suite est prête": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein nächstes Training ist bereit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next workout is ready"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La siguiente sesión está lista"
          }
        }
      }
    },
    "La suite non commencée a été raccourcie pour rester dans le temps choisi. Tout ce que tu as déjà fait est conservé.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der noch nicht begonnene Teil wurde gekürzt, damit die gewählte Zeit eingehalten wird. Alles bereits Erledigte bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The unstarted part was shortened to fit your chosen time. Everything you have already done is preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte que aún no habías empezado se ha acortado para respetar el tiempo elegido. Todo lo que ya has hecho se conserva."
          }
        }
      }
    },
    "La séance": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einheit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión"
          }
        }
      }
    },
    "La séance a été raccourcie uniquement sur le travail qui n’avait pas encore commencé, afin de respecter le temps choisi.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die gewählte Zeit einzuhalten, wurde nur noch nicht begonnene Arbeit gekürzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only work that had not yet started was removed to keep the workout within your chosen time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para respetar el tiempo elegido, solo se ha acortado el trabajo que aún no había empezado."
          }
        }
      }
    },
    "La séance a été recalculée sans les mouvements que tu as écartés. Vérifie le nouveau programme avant de commencer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Training wurde ohne die ausgeschlossenen Übungen neu berechnet. Prüfe vor dem Start den neuen Plan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workout was recalculated without the movements you excluded. Review the new plan before starting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión se ha recalculado sin los movimientos que has excluido. Revisa el nuevo programa antes de empezar."
          }
        }
      }
    },
    "La séance est restaurée à l’écran, mais sa réparation n’est pas encore sauvegardée.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Training wurde auf dem Bildschirm wiederhergestellt, die Reparatur aber noch nicht gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workout has been restored on screen, but the repair has not yet been saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión se ha restaurado en pantalla, pero la reparación aún no se ha guardado."
          }
        }
      }
    },
    "La séance n’a pas pu être fermée. Tu peux réessayer sans perdre ce bilan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Training konnte nicht geschlossen werden. Du kannst es erneut versuchen, ohne diese Zusammenfassung zu verlieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workout could not be closed. You can try again without losing this summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido cerrar la sesión. Puedes volver a intentarlo sin perder este resumen."
          }
        }
      }
    },
    "La séance n’a pas pu être sauvegardée. Rien n’a été perdu : tu peux réessayer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Training konnte nicht gespeichert werden. Es ist nichts verloren gegangen: Du kannst es erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workout could not be saved. Nothing was lost: you can try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar la sesión. No se ha perdido nada: puedes volver a intentarlo."
          }
        }
      }
    },
    "La séance reste volontairement compacte : elle utilise seulement les mouvements compatibles avec ton matériel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Training bleibt bewusst kompakt: Es verwendet nur Übungen, die mit deiner Ausrüstung möglich sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workout remains intentionally compact: it only uses movements that work with your equipment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión se mantiene deliberadamente compacta: solo utiliza movimientos compatibles con tu material."
          }
        }
      }
    },
    "La transaction n’a pas pu être vérifiée.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transaktion konnte nicht verifiziert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transaction could not be verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido verificar la transacción."
          }
        }
      }
    },
    "Laisser les répétitions évoluer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholungen wieder steigern lassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let reps progress"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar que las repeticiones progresen"
          }
        }
      }
    },
    "Lancer la séance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start workout"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar sesión"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Training starten"
          }
        }
      }
    },
    "Le bilan n’a pas été enregistré. La séance active et tes réponses sont conservées pour réessayer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zusammenfassung wurde nicht gespeichert. Dein aktives Training und deine Antworten bleiben für einen neuen Versuch erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The summary was not saved. Your active workout and answers are preserved so you can try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resumen no se ha guardado. La sesión activa y tus respuestas se conservan para que puedas volver a intentarlo."
          }
        }
      }
    },
    "Le choix n’a pas pu être enregistré. Le partage reste désactivé.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Auswahl konnte nicht gespeichert werden. Das Teilen bleibt deaktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your choice could not be saved. Sharing remains off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar tu elección. El envío sigue desactivado."
          }
        }
      }
    },
    "Le haut et le bas du corps peuvent démarrer différemment. Choisis ce qui te semble le plus naturel aujourd’hui ; tu pourras modifier chaque repère séparément.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ober- und Unterkörper können unterschiedlich einsteigen. Wähle, was sich heute am natürlichsten anfühlt; du kannst beide Ausgangswerte getrennt ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your upper and lower body can start at different points. Choose what feels most natural today; you can change each starting point separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tren superior y el inferior pueden empezar de forma diferente. Elige lo que te resulte más natural hoy; podrás modificar cada referencia por separado."
          }
        }
      }
    },
    "Le matériel enregistré ne permet pas encore un mouvement de tirage validé. Les autres familles restent couvertes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der gespeicherten Ausrüstung ist derzeit keine geprüfte Zugübung möglich. Die anderen Bewegungsgruppen bleiben abgedeckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved equipment does not yet support an approved pulling movement. The other movement families remain covered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El material registrado aún no permite un movimiento de tirón validado. Las demás familias siguen cubiertas."
          }
        }
      }
    },
    "Le montage tient correctement sur mes poignées": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The setup fits securely on my handles"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El montaje queda bien sujeto en mis empuñaduras"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Montage sitzt sicher auf meinen Griffen"
          }
        }
      }
    },
    "Le moteur a déjà ajusté la prochaine séance à ce bilan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Logik hat dein nächstes Training bereits an diese Zusammenfassung angepasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine has already adjusted your next workout to this summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor ya ha adaptado la próxima sesión a este resumen."
          }
        }
      }
    },
    "Le moteur local utilise le matériel, l’historique confirmé, le temps écoulé et les retours renseignés. Une pause ne crée pas de dette : le travail réalisé reste conservé.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Algorithmus nutzt Ausrüstung, bestätigten Verlauf, verstrichene Zeit und deine Rückmeldungen. Eine Pause erzeugt keine Schuld: absolvierte Arbeit bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local engine uses equipment, confirmed history, elapsed time and the feedback you provide. A break creates no debt: completed work is preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor local utiliza el material, el historial confirmado, el tiempo transcurrido y tus comentarios. Una pausa no genera deuda: el trabajo realizado se conserva."
          }
        }
      }
    },
    "Le moteur répartit le temps entre les grandes familles de mouvements compatibles avec ce que tu as chez toi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Logik verteilt die Zeit auf die wichtigsten Bewegungsgruppen, die mit deiner Ausrüstung zu Hause möglich sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine divides the available time between the main movement families supported by the equipment you have at home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor reparte el tiempo entre las principales familias de movimientos compatibles con lo que tienes en casa."
          }
        }
      }
    },
    "Le moteur standard n’est pas proposé dans cette situation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Standardlogik ist in dieser Situation nicht verfügbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The standard engine is not available in this situation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor estándar no está disponible en esta situación"
          }
        }
      }
    },
    "Le mouvement reste utilisable en interne. La vidéo finale sera ajoutée après le branding.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übung bleibt intern nutzbar. Das endgültige Video wird nach dem Branding ergänzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The movement remains available internally. The final video will be added after branding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El movimiento sigue disponible internamente. El vídeo final se añadirá después del branding."
          }
        }
      }
    },
    "Le partage a évolué. Les envois sont suspendus jusqu’à un nouvel accord.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freigabe hat sich geändert. Uploads pausieren bis zu einer neuen Einwilligung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing has changed. Uploads are paused until you consent again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El intercambio ha cambiado. Los envíos se pausan hasta un nuevo consentimiento."
          }
        }
      }
    },
    "Le partage n’est pas disponible dans cette version. Aucune donnée n’est envoyée.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Teilen ist in dieser Version nicht verfügbar. Es werden keine Daten gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing is unavailable in this version. No data is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir no está disponible en esta versión. No se envían datos."
          }
        }
      }
    },
    "Le renforcement musculaire est recommandé aux femmes comme aux hommes. Cela ne veut pas dire que leurs capacités, leurs besoins ou toutes leurs réponses à l’entraînement sont identiques.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Krafttraining wird Frauen und Männern empfohlen. Das bedeutet nicht, dass ihre Fähigkeiten, Bedürfnisse oder sämtliche Trainingsreaktionen identisch sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resistance training is recommended for women and men. This does not mean their abilities, needs or all their responses to training are identical."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entrenamiento de fuerza se recomienda tanto a mujeres como a hombres. Eso no significa que sus capacidades, necesidades o todas sus respuestas al entrenamiento sean idénticas."
          }
        }
      }
    },
    "Le repos fait partie de la séance. Il n’y a rien à rattraper.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pause gehört zum Training. Du musst nichts nachholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest is part of the workout. There is nothing to make up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El descanso forma parte de la sesión. No hay nada que recuperar."
          }
        }
      }
    },
    "Le réglage de partage est indisponible. Aucune donnée ne sera envoyée.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freigabeeinstellung ist nicht verfügbar. Es werden keine Daten gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing settings are unavailable. No data will be sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ajuste de envío no está disponible. No se enviarán datos."
          }
        }
      }
    },
    "Le signal déclaré a arrêté le moteur standard. Aucun diagnostic ni contournement chargé n’est proposé.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gemeldete Symptom hat die Standardlogik gestoppt. Es werden weder eine Diagnose noch eine belastende Ausweichlösung vorgeschlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reported symptom stopped the standard engine. No diagnosis or loaded workaround is suggested."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El síntoma indicado ha detenido el motor estándar. No se propone ningún diagnóstico ni alternativa con carga."
          }
        }
      }
    },
    "Le volume a été ajusté à partir de tes dernières séances, sans chercher à compenser ni à te pousser au-delà du nécessaire.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Umfang wurde anhand deiner letzten Trainings angepasst, ohne etwas nachholen zu wollen oder dich weiter als nötig zu belasten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The volume was adjusted from your recent workouts, without trying to compensate or push you beyond what is needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen se ha adaptado a partir de tus últimas sesiones, sin intentar compensar ni exigirte más de lo necesario."
          }
        }
      }
    },
    "Les anciens détails seront conservés tant que tu ne modifies pas ce matériel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous details will be kept until you edit this equipment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los detalles anteriores se conservarán hasta que modifiques este material."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bisherigen Angaben bleiben erhalten, bis du diese Ausrüstung bearbeitest."
          }
        }
      }
    },
    "Les comptes rendus de séance sont conservés 90 jours sur notre serveur privé. Le partage ne change ni ton accès ni l’adaptation locale de tes séances et n’autorise pas une modification individuelle à distance.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainingsberichte werden 90 Tage auf unserem privaten Server gespeichert. Das Teilen verändert weder deinen Zugang noch die lokale Trainingsanpassung und erlaubt keine individuellen Änderungen aus der Ferne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workout reports are kept for 90 days on our private server. Sharing changes neither your access nor local workout adaptation and does not authorize individual remote changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los informes de sesión se conservan 90 días en nuestro servidor privado. Compartir no cambia tu acceso ni la adaptación local de tus sesiones y no autoriza cambios individuales a distancia."
          }
        }
      }
    },
    "Les deux offres ne sont pas encore disponibles.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Abos sind derzeit nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither subscription option is available yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no están disponibles las dos opciones de suscripción."
          }
        }
      }
    },
    "Les données partagées ont été supprimées. Ton historique sur cet iPhone est conservé.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die geteilten Daten wurden gelöscht. Dein Verlauf auf diesem iPhone bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared data has been deleted. Your history on this iPhone is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos compartidos se han eliminado. Tu historial en este iPhone se conserva."
          }
        }
      }
    },
    "Les envois sont suspendus tant que l’accès payant n’est pas vérifié.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Senden ist pausiert, bis der bezahlte Zugang bestätigt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads are paused until paid access is verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los envíos se pausan hasta verificar el acceso de pago."
          }
        }
      }
    },
    "Les exercices restants seront notés comme non terminés, sans dette ni punition.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die verbleibenden Übungen werden als nicht beendet markiert. Du musst sie später nicht nachholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remaining exercises will be marked as not completed. You will not need to make them up later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ejercicios restantes se marcarán como no terminados. No tendrás que recuperarlos más tarde."
          }
        }
      }
    },
    "Les mouvements écartés ne laissent aucun programme valide dans le catalogue actuel. Tes choix sont conservés pour être modifiés.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit den ausgeschlossenen Übungen bleibt im aktuellen Katalog kein gültiger Plan. Deine Auswahl bleibt gespeichert, damit du sie ändern kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The excluded movements leave no valid plan in the current catalogue. Your choices are kept so you can change them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los movimientos excluidos no dejan ningún programa válido en el catálogo actual. Tus opciones se conservan para que puedas modificarlas."
          }
        }
      }
    },
    "Les offres n’ont pas pu être chargées.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Angebote konnten nicht geladen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The offers could not be loaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido cargar las ofertas."
          }
        }
      }
    },
    "Les offres sont indisponibles pour le moment.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Angebote sind derzeit nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The offers are currently unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ofertas no están disponibles en este momento."
          }
        }
      }
    },
    "Les précisions enregistrées sont illisibles. Le matériel existant reste conservé tant que tu ne le modifies pas.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherten Angaben sind nicht lesbar. Deine vorhandenen Geräte bleiben erhalten, solange du sie nicht änderst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved details cannot be read. Your existing equipment is kept unless you change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden leer los detalles guardados. Tu material actual se conserva mientras no lo modifiques."
          }
        }
      }
    },
    "Les rappels et le partage de statistiques ne sont pas encore disponibles.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen und das Teilen von Statistiken sind noch nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders and statistics sharing are not available yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios y el envío de estadísticas aún no están disponibles."
          }
        }
      }
    },
    "Les repères enregistrés ne peuvent pas être lus. Tes données sont conservées.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Angaben konnten nicht gelesen werden. Deine Daten bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved starting points could not be read. Your data is preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden leer las referencias guardadas. Tus datos se conservan."
          }
        }
      }
    },
    "Les repères n’ont pas été enregistrés. Tes choix restent affichés pour réessayer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Ausgangswerte wurden nicht gespeichert. Deine Auswahl bleibt für einen neuen Versuch sichtbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your starting points were not saved. Your choices remain displayed so you can try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las referencias no se han guardado. Tus opciones siguen visibles para que puedas volver a intentarlo."
          }
        }
      }
    },
    "Les répétitions et les charges réalisées servent de repères pour la suite. La proposition tient compte du matériel disponible et reste ajustable.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolvierte Wiederholungen und Lasten dienen als Anhaltspunkte für die nächste Einheit. Der Vorschlag berücksichtigt die verfügbare Ausrüstung und bleibt anpassbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed repetitions and loads guide what comes next. The suggestion accounts for available equipment and remains adjustable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las repeticiones y cargas realizadas sirven de referencia para lo siguiente. La propuesta tiene en cuenta el material disponible y se puede ajustar."
          }
        }
      }
    },
    "Les simulations vérifient la cohérence des règles ; elles ne prouvent pas leur efficacité chez chaque personne.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulationen prüfen die Konsistenz der Regeln; sie beweisen nicht deren Wirksamkeit bei jeder Person."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulations check the consistency of the rules; they do not prove their effectiveness for each person."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las simulaciones comprueban la coherencia de las reglas; no prueban su eficacia para cada persona."
          }
        }
      }
    },
    "Les séances en attente ont été transmises.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausstehende Trainings wurden gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pending workouts have been sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones pendientes se han enviado."
          }
        }
      }
    },
    "Les séries déjà enregistrées restent conservées.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits gespeicherte Sätze bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets already recorded are preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las series ya registradas se conservan."
          }
        }
      }
    },
    "Les séries déjà réalisées sont conservées. Les séries restantes de cet exercice seront passées.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine absolvierten Sätze bleiben erhalten. Die verbleibenden Sätze dieser Übung werden übersprungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your completed sets are kept. The remaining sets of this exercise will be skipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan las series realizadas. Se omitirán las series restantes de este ejercicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séries déjà réalisées sont conservées. Les séries restantes de cet exercice seront passées."
          }
        }
      }
    },
    "Lever de chaise": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufstehen vom Stuhl"
          }
        },
        "en": {
