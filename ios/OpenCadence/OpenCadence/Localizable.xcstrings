            "value": "Peso"
          }
        }
      }
    },
    "Charge maximale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum load"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga máxima"
          }
        },
