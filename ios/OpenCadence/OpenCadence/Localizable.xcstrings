            "state": "translated",
            "value": "Sit to stand"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantarse de la silla"
          }
        }
      }
    },
    "Lever les bras au-dessus de la tête": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arme über den Kopf heben"
          }
        },
        "en": {
