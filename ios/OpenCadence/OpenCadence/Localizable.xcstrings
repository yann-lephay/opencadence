    "Une séance adaptée à votre temps et à votre matériel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Training, das zu deiner Zeit und Ausrüstung passt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A workout adapted to your time and equipment"
          }
