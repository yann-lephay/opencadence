    "Sur %@, garde la même charge : aucun palier supérieur déclaré n’est disponible.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte bei %@ dasselbe Gewicht bei: Es ist keine höhere angegebene Stufe verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For %@, keep the same weight: no higher declared increment is available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@, mantén el mismo peso: no hay disponible ningún incremento superior declarado."
          }
        }
      }
    },
    "Sur %@, le moteur propose une répétition de plus à charge identique.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ schlägt die Logik eine weitere Wiederholung mit demselben Gewicht vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For %@, the engine suggests one more rep at the same weight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@, el motor propone una repetición más con el mismo peso."
          }
        }
      }
    },
    "Sur %@, le prochain palier disponible est %@ kg par haltère, avec un retour en bas de fourchette.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ liegt die nächste verfügbare Stufe bei %@ kg pro Hantel, mit einer Rückkehr an das untere Ende des Wiederholungsbereichs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For %@, the next available increment is %@ kg per dumbbell, returning to the low end of the rep range."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@, el siguiente incremento disponible es de %@ kg por mancuerna, volviendo a la parte baja del rango."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "new",
            "value": "Sur %1$@, le prochain palier disponible est %2$@ kg par haltère, avec un retour en bas de fourchette."
          }
        }
      }
    },
    "Sur les séances précédentes, tu as fait moins de répétitions que prévu.": {
