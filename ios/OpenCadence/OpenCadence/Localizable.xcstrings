    "À bientôt.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis bald."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See you soon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta pronto."
          }
        }
      }
    },
    "À la première séance, ton niveau reste à découvrir. Tu peux modifier la charge ou t’arrêter.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der ersten Einheit ist dein Niveau noch offen. Du kannst die Last ändern oder aufhören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your first session, your level is still being discovered. You can change the load or stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la primera sesión, tu nivel aún está por descubrir. Puedes cambiar la carga o parar."
          }
        }
      }
    },
    "À partir de 3 sur 10, la série s’arrête avant de proposer la suite.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab 3 von 10 wird der Satz beendet, bevor die App den nächsten Schritt vorschlägt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At 3 out of 10 or above, the set stops before the app suggests what comes next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de 3 sobre 10, la serie se detiene antes de proponer lo siguiente."
          }
        }
      }
    },
